#!/bin/sh
### BEGIN INIT INFO
# Provides:          aurascope-dash
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: AuraScope live audio dashboard
### END INIT INFO

DAEMON=/usr/bin/aurascope-dash
PIDFILE=/var/run/aurascope-dash.pid
NAME=aurascope-dash

test -x "$DAEMON" || exit 0

case "$1" in
    start)
        echo "Starting $NAME"
        start-stop-daemon --start --quiet --background \
            --make-pidfile --pidfile "$PIDFILE" \
            --exec "$DAEMON"
        ;;
    stop)
        echo "Stopping $NAME"
        start-stop-daemon --stop --quiet --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "$NAME is running"
        else
            echo "$NAME is not running"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
